{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and per-workspace windows, and the in-app diff / resolve / file-history windows",
  "windows": ["main", "work-*", "diff-*", "merge-*", "filehist-*", "blame-*", "review-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "updater:default",
    "process:default",
    "opener:allow-open-url",
    "dialog:default"
  ]
}
