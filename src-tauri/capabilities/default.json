{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and in-app diff windows",
  "windows": ["main", "diff-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "opener:allow-open-url",
    "updater:default",
    "process:default",
    "opener:allow-open-url",
    "dialog:default"
  ]
}
